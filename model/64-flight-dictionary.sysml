    item fdrParameterTable : FlightParameterTable {
        doc /* Parameter table 10: the flight parameters of the FDR application. */
        :>> tableId = 10; :>> owner = ApplicationName::fdir;
        attribute r1 : ParameterRow { :>> parameterId = 37; :>> name = "commandLossTimeout"; :>> owner = ApplicationName::fdir; :>> value = 604800.0; :>> minimum = 3600.0; :>> maximum = 2592000.0; :>> unitSymbol = "s"; }
        attribute r2 : ParameterRow { :>> parameterId = 38; :>> name = "flameoutRetries"; :>> owner = ApplicationName::fdir; :>> value = 2.0; :>> minimum = 0.0; :>> maximum = 5.0; :>> unitSymbol = "1"; }
        attribute r3 : ParameterRow { :>> parameterId = 39; :>> name = "batteryLowFraction"; :>> owner = ApplicationName::fdir; :>> value = 0.3; :>> minimum = 0.1; :>> maximum = 0.6; :>> unitSymbol = "1"; }
        attribute r4 : ParameterRow { :>> parameterId = 40; :>> name = "impactProbabilityLimit"; :>> owner = ApplicationName::fdir; :>> value = 0.0001; :>> minimum = 1e-07; :>> maximum = 0.001; :>> unitSymbol = "1"; }
        :>> rows = (r1, r2, r3, r4);
    }
    item modParameterTable : FlightParameterTable {
        doc /* Parameter table 11: the flight parameters of the MOD application. */
        :>> tableId = 11; :>> owner = ApplicationName::modeManagement;
        attribute r1 : ParameterRow { :>> parameterId = 41; :>> name = "transitionTimeout"; :>> owner = ApplicationName::modeManagement; :>> value = 300.0; :>> minimum = 1.0; :>> maximum = 3600.0; :>> unitSymbol = "s"; }
        attribute r2 : ParameterRow { :>> parameterId = 42; :>> name = "twoStepWindow"; :>> owner = ApplicationName::modeManagement; :>> value = 600.0; :>> minimum = 10.0; :>> maximum = 3600.0; :>> unitSymbol = "s"; }
