        attribute r4 : ParameterRow { :>> parameterId = 44; :>> name = "autoTransitionDefault"; :>> owner = ApplicationName::modeManagement; :>> value = 1.0; :>> minimum = 0.0; :>> maximum = 1.0; :>> unitSymbol = "1"; }
