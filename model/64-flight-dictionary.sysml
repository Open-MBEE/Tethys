    item pbuParameterTable : FlightParameterTable {
        doc /* Parameter table 12: the flight parameters of the PBU application. */
        :>> tableId = 12; :>> owner = ApplicationName::parameterBootUpdate;
        attribute r1 : ParameterRow { :>> parameterId = 45; :>> name = "stagingBufferSize"; :>> owner = ApplicationName::parameterBootUpdate; :>> value = 65536.0; :>> minimum = 4096.0; :>> maximum = 65536.0; :>> unitSymbol = "1"; }
        attribute r2 : ParameterRow { :>> parameterId = 46; :>> name = "bootRetryLimit"; :>> owner = ApplicationName::parameterBootUpdate; :>> value = 3.0; :>> minimum = 1.0; :>> maximum = 5.0; :>> unitSymbol = "1"; }
        attribute r3 : ParameterRow { :>> parameterId = 47; :>> name = "eepromCycleLimit"; :>> owner = ApplicationName::parameterBootUpdate; :>> value = 100000.0; :>> minimum = 1000.0; :>> maximum = 100000.0; :>> unitSymbol = "1"; }
        attribute r4 : ParameterRow { :>> parameterId = 48; :>> name = "tableCount"; :>> owner = ApplicationName::parameterBootUpdate; :>> value = 12.0; :>> minimum = 1.0; :>> maximum = 12.0; :>> unitSymbol = "1"; }
        :>> rows = (r1, r2, r3, r4);
    }
    attribute flightLimitTable : FdirLimitTable {
        doc /* The flight limit table: the six thresholds the fault supervisor's cruise limits read, one row each. */
        :>> tableId = 13;
        :>> commandLossTimeout = 7.0 [d];
        :>> thrusterRestartDelay = 2.0 [h];
        :>> maximumFlameoutRetries = 2;
        :>> batteryLowFraction = 0.30;
        :>> earthExclusionRadius = 63781.37 [km];
        :>> maximumImpactProbability = 1.0e-4;
    }
    attribute tableLimits : MonitorLimits {
        doc /* The supervisor's limit set as read from the limit table: every threshold is a table row. */
        :>> commandLossTimeout = flightLimitTable.commandLossTimeout;
        :>> thrusterRestartDelay = flightLimitTable.thrusterRestartDelay;
        :>> maximumFlameoutRetries = flightLimitTable.maximumFlameoutRetries;
        :>> batteryLowFraction = flightLimitTable.batteryLowFraction;
        :>> earthExclusionRadius = flightLimitTable.earthExclusionRadius;
        :>> maximumImpactProbability = flightLimitTable.maximumImpactProbability;
    }
    attribute flightApids : ApidTable {
        doc /* The APID class bases of the flight dictionary: each class's packets are numbered upward from its base. */
        :>> housekeeping = 16;
        :>> guidance = 64;
        :>> propulsion = 128;
        :>> capture = 192;
        :>> relay = 256;
        :>> imaging = 320;
    }

    // ---- the dictionary and its consistency checks ----------------------------------------
    part def FlightDictionary :> Dictionary {
        doc /* The flight dictionary: the rows above collected, with the counts and the consistency flags the dictionary requirement reads computed from them. The opcode, mnemonic, APID and event id sequences are unique features, so a repeated value fails their evaluation. */
        item commands : CommandDefinition[*];
        item telemetryPoints : TelemetryPointDefinition[*];
        item events : EventDefinition[*];
        item packets : PacketDefinition[*];
        item parameterTables : FlightParameterTable[*];
        attribute limitTable : FdirLimitTable;
        attribute commandApids : Natural[*];
        attribute opcodeNumbers : Natural[*] = commands.opcodeNumber;
        attribute commandMnemonics : String[*] = commands.mnemonic;
        attribute telemetryMnemonics : String[*] = telemetryPoints.mnemonic;
        attribute eventIds : Natural[*] = events.eventId;
        attribute packetApids : Natural[*] = packets.apid;
        attribute apidsAllocated : Natural[*] = (packetApids, commandApids);
        attribute :>> commandCount = size(commands);
        attribute :>> telemetryPointCount = size(telemetryPoints);
        attribute :>> eventCount = size(events);
        attribute :>> packetCount = size(packets);
        attribute :>> opcodesUnique = size(opcodeNumbers) == commandCount;
        attribute :>> mnemonicsUnique = size(commandMnemonics) == commandCount and size(telemetryMnemonics) == telemetryPointCount;
        attribute :>> apidsUnique = size(apidsAllocated) == packetCount + size(commandApids);
        attribute :>> apidsWithinRange = apidsAllocated->forAll { in a : Natural; a <= apidMaximum };
        attribute :>> eventIdsUnique = size(eventIds) == eventCount;
        attribute :>> packetsSumToLength = packets->forAll { in p : PacketDefinition; p.layoutConsistent };
        attribute :>> commandsHaveModePrecondition = commands->forAll { in c : CommandDefinition; c.opcodeNumber != null and notEmpty(c.allowedModes) and includes(commandApids, c.apid) };
        attribute :>> pointsHaveSource = telemetryPoints->forAll { in t : TelemetryPointDefinition; t.source != null };
        attribute :>> parametersInRange = parameterTables->forAll { in t : FlightParameterTable; t.allInRange };
        attribute :>> fdirThresholdsReadLimitTable = cruiseLimits.commandLossTimeout == limitTable.commandLossTimeout
            and cruiseLimits.thrusterRestartDelay == limitTable.thrusterRestartDelay
            and cruiseLimits.maximumFlameoutRetries == limitTable.maximumFlameoutRetries
            and cruiseLimits.batteryLowFraction == limitTable.batteryLowFraction
            and cruiseLimits.earthExclusionRadius == limitTable.earthExclusionRadius
            and cruiseLimits.maximumImpactProbability == limitTable.maximumImpactProbability;
        attribute hazardousCommandCount : Natural = size(commands->select { in c : CommandDefinition; c.hazardous });
        attribute housekeepingPointCount : Natural = size(telemetryPoints->select { in t : TelemetryPointDefinition; t.kind == TelemetryKind::housekeeping });
        attribute faultEventCount : Natural = size(events->select { in e : EventDefinition; e.fdirRelevant });
        attribute abortOpcode : Opcode = Opcode::FDR_ABORT_TO_RETREAT;
        attribute abortIsHazardous : Boolean = commands->exists { in c : CommandDefinition; c.opcodeLiteral == abortOpcode and c.hazardous };
    }
    part flightDictionary : FlightDictionary {
        doc /* The Tethys flight dictionary at its current issue. */
        :>> apids = flightApids;
