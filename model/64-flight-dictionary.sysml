    // ---- time code and packet headers ---------------------------------------------------
    attribute def TethysTimeCode {
        doc /* The Tethys time code carried in every packet secondary header: 32 bits of seconds and 16 bits of 1/65 536 s fractions since the mission epoch, a fictional segmented code in the style of CCSDS 301.0-B-4 CUC. */
        attribute epoch : String = "2030-01-01T00:00:00 TRT";
        attribute coarseWidth : Natural = 32;
        attribute fineWidth : Natural = 16;
        attribute fineResolution : DurationValue = 1.52587890625e-5 [s];
        attribute width : Natural = coarseWidth + fineWidth;
    }
    attribute def PrimaryHeaderLayout {
        doc /* The CCSDS Space Packet primary header, 48 bits: version, type, secondary header flag, application process id, sequence flags, sequence count and data length (CCSDS 133.0-B-2 §4.1.3). */
        attribute versionWidth : Natural = 3;
        attribute typeWidth : Natural = 1;
        attribute secondaryHeaderFlagWidth : Natural = 1;
        attribute apidWidth : Natural = 11;
        attribute sequenceFlagsWidth : Natural = 2;
        attribute sequenceCountWidth : Natural = 14;
        attribute dataLengthWidth : Natural = 16;
        attribute width : Natural = versionWidth + typeWidth + secondaryHeaderFlagWidth + apidWidth + sequenceFlagsWidth + sequenceCountWidth + dataLengthWidth;
    }
    attribute def PacketField {
        doc /* One field of a packet data field: its order, bit offset from the start of the packet, width in bits and the mnemonic of the telemetry point it carries. */
        attribute order : Natural;
        attribute offset : Natural;
        attribute width : Natural;
        attribute point : String;
    }

    // ---- dictionary row definitions -----------------------------------------------------
    attribute def CommandArgument {
        doc /* A command argument: its range and the width it is packed into. An argument is typed by this and by its ISQ quantity type. */
        attribute minimum : Real;
        attribute maximum : Real;
        attribute widthBits : Natural;
    }
    item def CommandDefinition :> Command {
        doc /* One command of the dictionary: opcode literal and number, mnemonic, owning application, the modes it is accepted in, its criticality and hazard flag, and its arguments. */
        attribute opcodeLiteral : Opcode;
        attribute opcodeNumber : Natural;
        attribute mnemonic : String;
        attribute application : ApplicationName;
        attribute allowedModes : TugMode[1..*];
        attribute criticality : CommandCriticality;
        attribute hazardous : Boolean;
        attribute argumentCount : Natural;
        attribute argumentBits : Natural;
        attribute :>> opcode = mnemonic;
    }
    item def TelemetryPointDefinition :> TelemetryPoint {
        doc /* One telemetry point of the dictionary: id, source application, kind, sample rate, packed width and unit symbol. The typed value and limits are on the per-quantity specialisations. */
        attribute pointId : Natural;
        attribute source : ApplicationName;
        attribute kind : TelemetryKind;
        attribute rate : FrequencyValue;
        attribute widthBits : Natural;
        attribute unitSymbol : String;
    }
    item def TemperaturePoint :> TelemetryPointDefinition {
        doc /* A temperature point: value and red/yellow limits typed as ThermodynamicTemperatureValue. */
        attribute value : ThermodynamicTemperatureValue;
        attribute redLow : ThermodynamicTemperatureValue;
        attribute yellowLow : ThermodynamicTemperatureValue;
        attribute yellowHigh : ThermodynamicTemperatureValue;
        attribute redHigh : ThermodynamicTemperatureValue;
        attribute :>> widthBits = 16;
        attribute :>> unitSymbol = "K";
        assert constraint limitsOrdered { redLow <= yellowLow and yellowLow <= yellowHigh and yellowHigh <= redHigh }
    }
