        attribute r2 : ParameterRow { :>> parameterId = 2; :>> name = "recorderHighWater"; :>> owner = ApplicationName::cdh; :>> value = 0.9; :>> minimum = 0.5; :>> maximum = 0.99; :>> unitSymbol = "1"; }
        attribute r3 : ParameterRow { :>> parameterId = 3; :>> name = "clockSlewLimit"; :>> owner = ApplicationName::cdh; :>> value = 1.0; :>> minimum = 0.01; :>> maximum = 10.0; :>> unitSymbol = "s"; }
        attribute r4 : ParameterRow { :>> parameterId = 4; :>> name = "downlinkQueueDepth"; :>> owner = ApplicationName::cdh; :>> value = 64.0; :>> minimum = 8.0; :>> maximum = 512.0; :>> unitSymbol = "1"; }
        :>> rows = (r1, r2, r3, r4);
