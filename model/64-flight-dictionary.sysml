        attribute r2 : ParameterRow { :>> parameterId = 30; :>> name = "contactForceLimit"; :>> owner = ApplicationName::captureControl; :>> value = 200.0; :>> minimum = 1.0; :>> maximum = 500.0; :>> unitSymbol = "N"; }
        attribute r3 : ParameterRow { :>> parameterId = 31; :>> name = "cinchTension"; :>> owner = ApplicationName::captureControl; :>> value = 1000.0; :>> minimum = 10.0; :>> maximum = 2000.0; :>> unitSymbol = "N"; }
        attribute r4 : ParameterRow { :>> parameterId = 32; :>> name = "despinTorqueLimit"; :>> owner = ApplicationName::captureControl; :>> value = 0.5; :>> minimum = 0.0; :>> maximum = 1.0; :>> unitSymbol = "1"; }
        :>> rows = (r1, r2, r3, r4);
    }
    item autParameterTable : FlightParameterTable {
        doc /* Parameter table 9: the flight parameters of the AUT application. */
        :>> tableId = 9; :>> owner = ApplicationName::autonomy;
        attribute r1 : ParameterRow { :>> parameterId = 33; :>> name = "planHorizon"; :>> owner = ApplicationName::autonomy; :>> value = 86400.0; :>> minimum = 3600.0; :>> maximum = 604800.0; :>> unitSymbol = "s"; }
        attribute r2 : ParameterRow { :>> parameterId = 34; :>> name = "autonomyLevel"; :>> owner = ApplicationName::autonomy; :>> value = 1.0; :>> minimum = 0.0; :>> maximum = 3.0; :>> unitSymbol = "1"; }
        attribute r3 : ParameterRow { :>> parameterId = 35; :>> name = "waypointHoldDefault"; :>> owner = ApplicationName::autonomy; :>> value = 600.0; :>> minimum = 0.0; :>> maximum = 86400.0; :>> unitSymbol = "s"; }
        attribute r4 : ParameterRow { :>> parameterId = 36; :>> name = "ruleCooldown"; :>> owner = ApplicationName::autonomy; :>> value = 60.0; :>> minimum = 1.0; :>> maximum = 3600.0; :>> unitSymbol = "s"; }
        :>> rows = (r1, r2, r3, r4);
