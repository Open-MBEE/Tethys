    item def FractionPoint :> TelemetryPointDefinition {
        doc /* A fraction point: value and red/yellow limits typed as Real. */
        attribute value : Real;
        attribute redLow : Real;
        attribute yellowLow : Real;
        attribute yellowHigh : Real;
        attribute redHigh : Real;
        attribute :>> widthBits = 16;
        attribute :>> unitSymbol = "1";
        assert constraint limitsOrdered { redLow <= yellowLow and yellowLow <= yellowHigh and yellowHigh <= redHigh }
    }
    item def CountPoint :> TelemetryPointDefinition {
        doc /* A count point: value and red/yellow limits typed as Natural. */
        attribute value : Natural;
        attribute redLow : Natural;
        attribute yellowLow : Natural;
        attribute yellowHigh : Natural;
        attribute redHigh : Natural;
        attribute :>> widthBits = 32;
        attribute :>> unitSymbol = "1";
        assert constraint limitsOrdered { redLow <= yellowLow and yellowLow <= yellowHigh and yellowHigh <= redHigh }
    }
    item def StatusPoint :> TelemetryPointDefinition {
        doc /* A status point: value and red/yellow limits typed as Natural. */
        attribute value : Natural;
        attribute redLow : Natural;
        attribute yellowLow : Natural;
        attribute yellowHigh : Natural;
        attribute redHigh : Natural;
        attribute :>> widthBits = 8;
        attribute :>> unitSymbol = "1";
        assert constraint limitsOrdered { redLow <= yellowLow and yellowLow <= yellowHigh and yellowHigh <= redHigh }
    }
    item def EventDefinition :> SoftwareEvent {
        doc /* One event of the dictionary: id, mnemonic, source application, severity, the text the ground shows, and whether the fault application acts on it. */
        attribute eventId : Natural;
        attribute mnemonic : String;
        attribute source : ApplicationName;
        attribute severity : EventSeverity;
        attribute text : String;
        attribute fdirRelevant : Boolean;
    }
    item def PacketDefinition :> TelemetryPacket {
        doc /* One telemetry packet of the dictionary: its APID and class, source application, rate, header layout, ordered fields, and the length the field widths must sum to. */
        attribute packetId : Natural;
        attribute mnemonic : String;
        attribute apidClass : ApidClass;
        attribute source : ApplicationName;
        attribute rate : FrequencyValue;
        attribute primaryHeader : PrimaryHeaderLayout;
        attribute timeCode : TethysTimeCode;
        attribute headerBits : Natural = primaryHeader.width + timeCode.width;
        attribute fieldCount : Natural;
        attribute widths : Natural[*] nonunique;
        attribute offsets : Natural[*];
        attribute payloadBits : Natural = sum(widths);
        attribute lengthOctets : Natural;
        attribute :>> length = lengthOctets [B];
        attribute layoutConsistent : Boolean = headerBits + payloadBits == lengthOctets * 8 and size(widths) == fieldCount
            and last(offsets) + last(widths) == lengthOctets * 8;
    }
    attribute def ParameterRow {
        doc /* One row of a parameter table: id, name, owning application, flight value, range and unit symbol. */
        attribute parameterId : Natural;
        attribute name : String;
        attribute owner : ApplicationName;
        attribute value : Real;
        attribute minimum : Real;
        attribute maximum : Real;
        attribute unitSymbol : String;
        attribute inRange : Boolean = minimum <= value and value <= maximum;
    }
    item def FlightParameterTable :> ParameterTable {
        doc /* A parameter table of one application: its rows, loaded and activated by the table service. */
        attribute owner : ApplicationName;
        attribute rows : ParameterRow[*];
        attribute rowCount : Natural = SequenceFunctions::size(rows);
        attribute :>> size = rowCount * 16 [B];
        attribute allInRange : Boolean = rows->forAll { in r : ParameterRow; r.inRange };
    }
    attribute def FdirLimitTable {
        doc /* The limit table the fault supervisor's monitors read: one typed row per monitor threshold, named as the threshold is named in the supervisor's limit set. */
        attribute tableId : Natural;
        attribute commandLossTimeout : DurationValue;
        attribute thrusterRestartDelay : DurationValue;
        attribute maximumFlameoutRetries : Natural;
        attribute batteryLowFraction : Real;
        attribute earthExclusionRadius : LengthValue;
        attribute maximumImpactProbability : Real;
        attribute rowCount : Natural = 6;
    }

