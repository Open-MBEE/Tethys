    }
    enum def CommandCriticality {
        doc /* How a command is treated by the ground and the on-board command service: routine commands need no confirmation, critical ones are two-step on the ground, hazardous ones also carry a confirmation key on board. */
        enum routine;
        enum critical;
        enum hazardous;
    }
    enum def EventSeverity {
        doc /* Severity of an on-board event: information, a warning the operators review, a fault the fault application handles, or a critical event that drives a mode change. */
        enum info;
        enum warning;
        enum fault;
        enum critical;
    }
    enum def TelemetryKind {
        doc /* Housekeeping points are downlinked in every pass at a fixed rate; engineering points are recorded and downlinked on request. */
        enum housekeeping;
        enum engineering;
    }
